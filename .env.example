# ---------- GoHighLevel ----------
# Sub-account (location) Private Integration token.
# Create at: Settings -> Private Integrations -> Create new integration
# Required scopes:
#   contacts.readonly, contacts.write
#   opportunities.readonly, opportunities.write
#   locations/customFields.readonly, locations/customFields.write
#   locations/customValues.readonly, locations/customValues.write
#   conversations.readonly, conversations.write
#   conversations/message.readonly, conversations/message.write
#   users.readonly
GHL_API_KEY=pit-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
GHL_LOCATION_ID=
# Filled in by `npm run provision` after it reads your pipeline:
GHL_PIPELINE_ID=
GHL_STAGE_NEW=
GHL_STAGE_ACTIVE=
GHL_STAGE_PENDING_CUSTOMER=
GHL_STAGE_PENDING_INTERNAL=
GHL_STAGE_RESOLVED=

# ---------- Anthropic (AI analysis) ----------
ANTHROPIC_API_KEY=
# Model used for per-ticket classification and the trend digests.
AI_MODEL=claude-opus-5
# Set to 0 to turn off all AI analysis (the ticketing system still works).
AI_ENABLED=1

# ---------- Service ----------
PORT=3000
DATABASE_PATH=./data/support.db
# Shared secret. Every inbound webhook must present it as ?token= or X-Webhook-Secret.
WEBHOOK_SECRET=change-me-to-a-long-random-string
# Protects the /dashboard and /api/kpi routes (HTTP basic auth).
DASHBOARD_USER=support
DASHBOARD_PASSWORD=change-me

# ---------- Notifications ----------
SUPPORT_FROM_EMAIL=support@youragency.com
SUPPORT_FROM_NAME=Support Team
# Comma-separated GHL user emails that get internal alerts.
INTERNAL_ALERT_EMAILS=
# GHL contact id of the on-call person who receives P1 SMS alerts.
# `npm run provision` can create this contact for you and print the id.
P1_ALERT_CONTACT_ID=

# Set to 1 to run SLA checks, nudges and digests inside the web process
# (leave off if your host gives you real cron).
RUN_JOBS=1
